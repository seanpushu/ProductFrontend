# Copy to .env.local for local development.
# Everything prefixed VITE_ is compiled into the public JavaScript bundle:
# never put passwords, tokens or keys here.
VITE_API_BASE_URL=http://localhost:8080
# User Service. Use "localhost" (not 127.0.0.1) to match the page origin.
# In production leave it empty: auth paths are served from the same origin via CloudFront.
VITE_AUTH_BASE_URL=http://localhost:8081
